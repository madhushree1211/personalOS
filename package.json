{
  "name": "personalos",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"python -m uvicorn app.main:app --reload --port 4000 --app-dir backend\" \"npm run dev --workspace frontend\"",
    "build": "npm run build --workspace frontend",
    "start": "python -m uvicorn app.main:app --host 0.0.0.0 --port 4000 --app-dir backend",
    "test": "cd backend && python -m pytest -q"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
